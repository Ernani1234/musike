{
  "name": "musike-desktop",
  "productName": "Musike",
  "version": "1.5.1",
  "description": "Your music, uninterrupted.",
  "author": "Musike",
  "homepage": "https://github.com/Ernani1234/musike",
  "desktopName": "musike.desktop",
  "private": true,
  "main": "dist/main.mjs",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "pnpm --filter @musike/web build && node scripts/bundle.mjs && electron .",
    "dist": "pnpm --filter @musike/web build && node scripts/bundle.mjs && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm --filter @musike/web build && node scripts/bundle.mjs && electron-builder --mac --publish never",
    "dist:linux": "pnpm --filter @musike/web build && node scripts/bundle.mjs && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "app.musike.desktop",
    "productName": "Musike",
    "copyright": "Musike",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "artifactBuildCompleted": "build/collect.cjs",
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Musike-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.music",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "musike",
      "syncDesktopName": true,
      "category": "AudioVideo",
      "synopsis": "Your music, uninterrupted.",
      "description": "A personal music player for YouTube's catalog: songs and music videos, with no ads and no account.",
      "maintainer": "Musike <https://github.com/Ernani1234/musike>"
    },
    "deb": {
      "packageName": "musike"
    },
    "dmg": {
      "title": "Musike ${version}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Musike",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "en_US",
        "pt_BR",
        "it_IT"
      ],
      "language": "1033",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
