--- /dev/null
+++ b/server/test/media-session.test.ts
@@ -0,0 +1,32 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { mediaMetadata, mediaPlaybackState, registerMediaActions } from "../../web/src/lib/mediaSession.ts";
+import { playbackCommand } from "../../web/src/lib/playbackCommands.ts";
+
+test("media state retains loading intent and action handlers make play/pause idempotent", () => {
+  assert.equal(mediaPlaybackState("loading", true, true), "playing");
+  assert.equal(mediaPlaybackState("loading", false, true), "paused");
+  assert.equal(mediaPlaybackState("error", true, true), "paused");
+  assert.equal(mediaPlaybackState("idle", true, false), "none");
+  const handlers = new Map(); let toggles = 0; let status = "loading";
+  registerMediaActions({ setActionHandler: (name: string, action: unknown) => handlers.set(name, action) } as any,
+    () => ({ status, position: 3, toggle: () => { toggles++; status = status === "paused" ? "playing" : "paused"; }, next() {}, prev() {}, seek() {} }));
+  handlers.get("play")(); assert.equal(toggles, 0);
+  handlers.get("pause")(); assert.equal(toggles, 1); assert.equal(status, "paused");
+  handlers.get("pause")(); assert.equal(toggles, 1);
+  handlers.get("play")(); assert.equal(toggles, 2);
+});
+test("media metadata tolerates absent or invalid artwork", () => {
+  const t = { id: "abcdefghijk", title: "Fixture", artist: "Fixture", duration: 1, kind: "song" as const, thumb: "", art: "javascript:bad" };
+  assert.deepEqual(mediaMetadata(t).artwork, []);
+  assert.equal(mediaMetadata({ ...t, art: "https://i.ytimg.com/a.jpg", thumb: "https://i.ytimg.com/a.jpg" }).artwork?.length, 1);
+});
+test("wire commands strip zero-argument callback events and reject non-data arguments", () => {
+  const event: any = { target: {} }; event.target.fiber = event;
+  for (const action of ["toggle", "next", "prev", "clearUpcoming", "toggleShuffle", "cycleRepeat"]) assert.equal(JSON.stringify(playbackCommand(action, [event])), JSON.stringify({ action, args: [] }));
+  assert.throws(() => playbackCommand("seek", [event]));
+  assert.throws(() => playbackCommand("setAutoRadio", [event]));
+  assert.throws(() => playbackCommand("unknown", []));
+  const track = { id: "abcdefghijk", title: "Fixture", artist: "Fixture", duration: 1, kind: "song", thumb: "", art: "", event };
+  assert.doesNotThrow(() => JSON.stringify(playbackCommand("playTrack", [track])));
+});
diff --git a/server/test/offline-auth.test.ts b/server/test/offline-auth.test.ts
new file mode 100644
index 0000000..0399ac1
--- /dev/null
+++ b/server/test/offline-auth.test.ts
@@ -0,0 +1,52 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import "fake-indexeddb/auto";
+import { JSDOM } from "jsdom";
+import { build } from "esbuild";
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { tmpdir } from "node:os";
+import { pathToFileURL } from "node:url";
+import { offlineSettings, purgeOfflineOwner } from "../../web/src/lib/offlineStore.ts";
+
+for (const mode of ["offline", "unauthorized", "unauthorized-html", "challenge", "pending-logout"] as const) test(`offline AuthGate: ${mode}`, async () => {
+  const dir = await mkdtemp(path.join(tmpdir(), "musike-offline-auth-")); const root = path.resolve("../web/src"); const owner = crypto.randomUUID();
+  await offlineSettings(owner, { enabled: true, eligible: true, name: "Fixture" });
+  const dom = new JSDOM('<div id="root"></div>', { url: "https://fixture.invalid" });
+  dom.window.localStorage.setItem("musike:offline-owner", owner);
+  if (mode === "pending-logout") dom.window.localStorage.setItem("musike:logout-pending", "1");
+  const requests: string[] = [];
+  const globals = { window: dom.window, document: dom.window.document, navigator: dom.window.navigator, Event: dom.window.Event,
+    localStorage: dom.window.localStorage, sessionStorage: dom.window.sessionStorage,
+    fetch: async (url: string) => {
+      requests.push(url);
+      if (mode === "offline" || mode === "pending-logout") throw new TypeError("fixture network failure");
+      if (mode === "unauthorized") return new Response('{"error":"Sign in required"}', { status: 401, headers: { "content-type": "application/json" } });
+      return new Response('<html>fixture challenge</html>', { status: mode === "unauthorized-html" ? 401 : 403, headers: { "content-type": "text/html" } });
+    } };
+  const previous = new Map(Object.keys(globals).map(k => [k, Object.getOwnPropertyDescriptor(globalThis, k)]));
+  for (const [key, value] of Object.entries(globals)) Object.defineProperty(globalThis, key, { configurable: true, writable: true, value });
+  let unmount: (() => void) | undefined;
+  try {
+    const result = await build({ stdin: { contents: `import React from 'react';import {createRoot} from 'react-dom/client';import {flushSync} from 'react-dom';import {AuthGate} from './components/AuthGate';export {useSession} from './stores/session';export function mount(){const root=createRoot(document.getElementById('root'));flushSync(()=>root.render(React.createElement(AuthGate,null,React.createElement('span',{'data-offline-child':true},'library'))));return ()=>flushSync(()=>root.unmount());}`, loader: "tsx", resolveDir: root },
+      bundle: true, platform: "node", format: "esm", write: false, define: { "process.env.NODE_ENV": '"production"', "import.meta.env.MODE": '"test"' },
+      plugins: [{ name: "auth-messages", setup(p) { p.onLoad({ filter: /i18n\/index.ts$/ }, () => ({ contents: "import {en} from './en';export const getT=()=>en;export const useT=getT;", loader: "ts" })); } }] });
+    const file = path.join(dir, "auth.mjs"); await writeFile(file, result.outputFiles[0]!.text); const mod = await import(pathToFileURL(file).href); unmount = mod.mount();
+    for (let n = 0; n < 200; n++) { await new Promise(r => setTimeout(r, 2)); if (!dom.window.document.body.textContent?.includes("Loading")) break; }
+    if (mode === "offline") {
+      assert.ok(dom.window.document.querySelector("[data-offline-child]"));
+      assert.equal(mod.useSession.getState().user.id, owner); assert.equal(mod.useSession.getState().offline, true);
+      assert.equal(mod.useSession.getState().user.phone, ""); assert.equal(mod.useSession.getState().user.role, "user");
+      assert.equal(dom.window.sessionStorage.getItem("musike:user"), owner);
+    } else {
+      assert.equal(dom.window.document.querySelector("[data-offline-child]"), null);
+      assert.equal(mod.useSession.getState().user, null);
+      if (mode === "pending-logout") assert.deepEqual(requests, ["/api/auth/logout"]);
+      if (mode.startsWith("unauthorized")) assert.equal(dom.window.localStorage.getItem("musike:offline-owner"), null);
+    }
+  } finally {
+    unmount?.(); dom.window.close(); await purgeOfflineOwner(owner);
+    for (const [key, descriptor] of previous) if (descriptor) Object.defineProperty(globalThis, key, descriptor); else delete (globalThis as any)[key];
+    await rm(dir, { recursive: true, force: true });
+  }
+});
diff --git a/server/test/offline-downloads.test.ts b/server/test/offline-downloads.test.ts
new file mode 100644
index 0000000..9436c73
--- /dev/null
+++ b/server/test/offline-downloads.test.ts
@@ -0,0 +1,100 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import "fake-indexeddb/auto";
+import { build } from "esbuild";
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { offlineSettings, offlineSummary, purgeOfflineOwner } from "../../web/src/lib/offlineStore.ts";
+
+const track = (n: number) => ({ id: String(n).padStart(11, "0"), title: `Fixture ${n}`, artist: "Fixture", duration: 3, thumb: "", art: "", kind: "video" });
+const tick = () => new Promise(resolve => setImmediate(resolve));
+async function harness() {
+  const dir = await mkdtemp(path.join(tmpdir(), "musike-offline-")); const owner = crypto.randomUUID();
+  const values = new Map<string, string>([["musike:user", owner]]); const local = new Map();
+  const storage = (map: Map<string, string>) => ({ getItem: (key: string) => map.get(key) ?? null, setItem: (key: string, v: string) => map.set(key, v), removeItem: (key: string) => map.delete(key) });
+  const browser = new EventTarget(); const h: any = { offline: false, requests: [], fail: "" };
+  const globals = { __offlineHarness: h, sessionStorage: storage(values), localStorage: storage(local), window: browser,
+    navigator: { onLine: true, storage: { estimate: async () => ({ usage: 123 }), persisted: async () => true, persist: async () => true } },
+    fetch: async (url: string, init: RequestInit) => { h.requests.push(url); if (h.transport) return h.transport(url, init); if (h.fail && url.includes(h.fail)) throw new Error("fixture offline"); return new Response("complete-audio", { headers: { "content-type": "audio/mp4" } }); } };
+  const old = new Map(Object.keys(globals).map(key => [key, Object.getOwnPropertyDescriptor(globalThis, key)]));
+  for (const [key, value] of Object.entries(globals)) Object.defineProperty(globalThis, key, { configurable: true, writable: true, value });
+  const root = path.resolve("../web/src"); const mocks = new Map([
+    [path.join(root, "i18n/index.ts"), 'export const getT=()=>({offline:{storageUnavailable:"storage",enableFirst:"enable",budgetFull:"budget",incomplete:"incomplete"}});'],
+    [path.join(root, "stores/session.ts"), 'const h=globalThis.__offlineHarness;export const useSession={getState:()=>({offline:h.offline})};'],
+  ]);
+  const result = await build({ stdin: { contents: `export * from "${root}/lib/offlineDownloads.ts";export {useOffline} from "${root}/stores/offline.ts";`, resolveDir: root }, bundle: true, write: false, platform: "node", format: "esm",
+    plugins: [{ name: "offline-platform", setup(p) { p.onLoad({ filter: /\.(ts|tsx)$/ }, args => mocks.has(args.path) ? { contents: mocks.get(args.path)!, loader: "ts" } : undefined); } }] });
+  const file = path.join(dir, "offline.mjs"); await writeFile(file, result.outputFiles[0]!.text); const mod = await import(pathToFileURL(file).href);
+  const settled = async () => { for (let n = 0; n < 300; n++) { await tick(); if (!mod.useOffline.getState().busy) return; } throw new Error("download did not settle"); };
+  return { mod, h, owner, settled, cleanup: async () => { mod.cancelOfflineDownloads(); await settled(); await purgeOfflineOwner(owner); for (const [key, value] of old) if (value) Object.defineProperty(globalThis, key, value); else delete (globalThis as any)[key]; await rm(dir, { recursive: true, force: true }); } };
+}
+test("download admission rejects partial, video, empty and HTML responses; video catalog items use audio-only URLs", async () => {
+  const f = await harness();
+  try {
+    for (const [status, type, body] of [[206, "audio/mp4", "partial"], [200, "video/mp4", "video"], [200, "text/html", "challenge"], [200, "audio/mp4", ""]] as const) {
+      await assert.rejects(f.mod.fetchCompleteAudio(track(1).id, new AbortController().signal, async () => new Response(body, { status, headers: { "content-type": type } })));
+    }
+    const body = await f.mod.fetchCompleteAudio(track(1).id, new AbortController().signal);
+    assert.equal(await body.text(), "complete-audio"); assert.match(f.h.requests[0], /\/audio$/);
+    assert.ok(!f.h.requests[0].includes("/video"));
+  } finally { await f.cleanup(); }
+});
+test("explicit playlist jobs resume without refetching complete bodies and logout removes the account cache", async () => {
+  const f = await harness();
+  try {
+    await f.mod.rememberOfflineAccount(f.owner, "Fixture"); assert.equal(await f.mod.cachedOfflineAccount(), null);
+    await f.mod.setOfflineBudget(512, true);
+    const playlist = { id: "copy", name: "Personal copy", createdAt: 1, updatedAt: 1, tracks: [track(1), track(2)] };
+    f.h.fail = track(2).id;
+    await f.mod.pinOfflinePlaylist(playlist); await f.settled();
+    assert.equal((await offlineSummary(f.owner)).entries.length, 1);
+    assert.ok((await offlineSummary(f.owner)).pins[0].pending);
+    assert.equal(f.mod.useOffline.getState().error, "incomplete");
+    f.h.fail = ""; await f.mod.pinOfflinePlaylist(playlist); await f.settled();
+    const ready = await offlineSummary(f.owner);
+    assert.equal(ready.pins[0].pending, null); assert.equal(ready.entries.length, 2);
+    assert.equal(f.h.requests.filter((u: string) => u.includes(track(1).id)).length, 1);
+    assert.equal((await f.mod.cachedOfflineAccount()).phone, "");
+    const url = await f.mod.offlineAudioUrl(track(1).id); assert.ok(url.startsWith("blob:")); URL.revokeObjectURL(url);
+    await f.mod.setOfflineBudget(512, false); assert.ok(await f.mod.cachedOfflineAccount());
+    await f.mod.logoutOfflineData(); assert.equal(await f.mod.cachedOfflineAccount(), null);
