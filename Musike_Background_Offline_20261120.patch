+const OWNER = "musike:offline-owner";
+export const offlineOwner = () => { try { return sessionStorage.getItem("musike:user") || null; } catch { return null; } };
+let generation = 0;
+let controller: AbortController | null = null;
+let recent: Track | null = null;
